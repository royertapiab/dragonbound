<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> — DragonBound Admin</title>
    <link rel="stylesheet" href="/static/css/admin.css">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚔️</text></svg>">
</head>
<body>
    <div class="app-container">
        <%- include('../layouts/sidebar') %>

        <div class="main-content">
            <%- include('../layouts/header') %>

            <main class="page-container">
                <%- include('../layouts/alerts') %>

                <!-- Add Staff Card -->
                <div class="card" style="margin-bottom: 24px;">
                    <h3 class="card-title">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <line x1="19" y1="8" x2="19" y2="14"></line>
                            <line x1="22" y1="11" x2="16" y2="11"></line>
                        </svg>
                        Nombrar Nuevo Administrador / Staff
                    </h3>

                    <form action="/staff" method="POST" style="display: flex; gap: 12px; flex-wrap: wrap; align-items: flex-end;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                        <div style="flex: 2; min-width: 220px;">
                            <label class="form-label">Usuario de Juego (Login Username)</label>
                            <input type="text" name="username" class="form-control" placeholder="Ej. rtapiab o 1nsane" required>
                        </div>

                        <div style="flex: 2; min-width: 200px;">
                            <label class="form-label">Rol Administrativo</label>
                            <select name="roleId" class="form-control" required>
                                <% roles.forEach(r => { %>
                                    <option value="<%= r.id %>"><%= r.name %> — <%= r.description %></option>
                                <% }); %>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            Otorgar Acceso Staff
                        </button>
                    </form>
                </div>

                <!-- Staff Roster Table -->
                <div class="card-table">
                    <div class="table-header">
                        <h3 style="font-size: 15px; font-weight: 700; color: #fff;">Personal Administrativo Activo (<%= staff.length %>)</h3>
                    </div>

                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Usuario / Nickname</th>
                                <th>Rol en el Panel</th>
                                <th>Estado</th>
                                <th>Fecha Alta</th>
                                <th style="text-align: right;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% staff.forEach(s => { %>
                                <tr>
                                    <td>#<%= s.admin_user_id %></td>
                                    <td>
                                        <a href="/players/<%= s.game_user_id %>" style="color: #60a5fa; font-weight: 700; text-decoration: none;">
                                            <%= s.game_id || s.Username %>
                                        </a>
                                        <span style="font-size: 11px; color: var(--text-dim); margin-left: 4px;">(<%= s.Username %>)</span>
                                    </td>
                                    <td>
                                        <span class="role-badge <%= s.role_name %>">
                                            <%= s.role_name %>
                                        </span>
                                    </td>
                                    <td>
                                        <% if (s.is_active === 1) { %>
                                            <span class="status-pill online">Activo</span>
                                        <% } else { %>
                                            <span class="status-pill offline">Inactivo</span>
                                        <% } %>
                                    </td>
                                    <td><span style="font-size: 12px;"><%= formatDate(s.created_at) %></span></td>
                                    <td style="text-align: right;">
                                        <div style="display: inline-flex; gap: 8px; align-items: center;">
                                            <!-- Change Role Form -->
                                            <form action="/staff/<%= s.admin_user_id %>/role" method="POST" style="margin: 0; display: inline-flex; gap: 4px;">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <select name="roleId" class="form-control" style="width: auto; padding: 4px 8px; font-size: 12px;" onchange="this.form.submit()">
                                                    <% roles.forEach(r => { %>
                                                        <option value="<%= r.id %>" <%= s.role_id === r.id ? 'selected' : '' %>><%= r.name %></option>
                                                    <% }); %>
                                                </select>
                                            </form>

                                            <!-- Toggle Active -->
                                            <form action="/staff/<%= s.admin_user_id %>/status" method="POST" style="margin: 0;">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="is_active" value="<%= s.is_active === 1 ? '0' : '1' %>">
                                                <button type="submit" class="btn btn-sm btn-secondary" title="<%= s.is_active === 1 ? 'Desactivar acceso' : 'Activar acceso' %>">
                                                    <%= s.is_active === 1 ? 'Suspender' : 'Activar' %>
                                                </button>
                                            </form>

                                            <!-- Delete Staff -->
                                            <% if (s.role_name !== 'OWNER') { %>
                                                <form action="/staff/<%= s.admin_user_id %>/delete" method="POST" style="margin: 0;" onsubmit="return confirm('¿Remover a este miembro del personal administrativo?');">
                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                    <button type="submit" class="btn btn-sm btn-danger" title="Eliminar staff">
                                                        &times;
                                                    </button>
                                                </form>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>

                <!-- Roles & Permissions Matrix -->
                <div class="card-table">
                    <div class="table-header">
                        <h3 style="font-size: 15px; font-weight: 700; color: #fff;">Matriz de Roles & Permisos del Sistema</h3>
                        <span style="font-size: 12px; color: var(--text-dim);"><%= permissions.length %> permisos configurables</span>
                    </div>

                    <table>
                        <thead>
                            <tr>
                                <th>Clave de Permiso</th>
                                <th>Descripción</th>
                                <% roles.forEach(r => { %>
                                    <th style="text-align: center;"><%= r.name %></th>
                                <% }); %>
                            </tr>
                        </thead>
                        <tbody>
                            <% permissions.forEach(p => { %>
                                <tr>
                                    <td><code style="color: #60a5fa; font-weight: 600;"><%= p.permission_key %></code></td>
                                    <td><%= p.name %> <span style="font-size: 11px; color: var(--text-dim);">(<%= p.description %>)</span></td>
                                    <% roles.forEach(r => { %>
                                        <td style="text-align: center;">
                                            <% if (r.name === 'OWNER' || (matrix[r.id] && matrix[r.id].has(p.id))) { %>
                                                <span style="color: var(--success); font-weight: 900; font-size: 15px;">&check;</span>
                                            <% } else { %>
                                                <span style="color: var(--text-dim); opacity: 0.3;">&mdash;</span>
                                            <% } %>
                                        </td>
                                    <% }); %>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>

            </main>

            <%- include('../layouts/footer') %>
        </div>
    </div>
</body>
</html>
