<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> — DragonBound Admin</title>
    <link rel="stylesheet" href="/static/css/admin.css">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚔️</text></svg>">
</head>
<body>
    <div class="app-container">
        <%- include('../layouts/sidebar') %>

        <div class="main-content">
            <%- include('../layouts/header') %>

            <main class="page-container">
                <%- include('../layouts/alerts') %>

                <!-- Navigation Tabs -->
                <div class="tabs-nav">
                    <a href="/moderation" class="tab-btn active">Cuentas Sancionadas</a>
                    <a href="/moderation/ip-bans" class="tab-btn">Bloqueo de IPs</a>
                    <a href="/moderation/sessions" class="tab-btn">Sesiones Online (Kick)</a>
                </div>

                <!-- Action Header -->
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
                    <div>
                        <h2 style="font-size: 18px; font-weight: 800; color: #fff;">Gestión de Sanciones y Baneos</h2>
                        <p style="font-size: 13px; color: var(--text-dim);">Aplica o levanta sanciones directamente sobre cuentas de juego.</p>
                    </div>

                    <button type="button" class="btn btn-danger" onclick="document.getElementById('ban-modal').style.display='block'">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                        </svg>
                        Banear Jugador
                    </button>
                </div>

                <!-- Filter Bar -->
                <div class="filter-bar">
                    <form action="/moderation" method="GET" style="display: flex; gap: 12px; flex-wrap: wrap; width: 100%; align-items: center;">
                        <input 
                            type="text" 
                            name="search" 
                            class="form-control" 
                            placeholder="Buscar por usuario, razón o GM que sancionó..." 
                            value="<%= filters.search || '' %>"
                            style="max-width: 360px;"
                        >
                        <button type="submit" class="btn btn-primary">Buscar</button>
                        <% if (filters.search) { %>
                            <a href="/moderation" class="btn btn-secondary">Limpiar</a>
                        <% } %>
                    </form>
                </div>

                <!-- Active Bans Table -->
                <div class="card-table">
                    <div class="table-header">
                        <h3 style="font-size: 15px; font-weight: 700; color: #fff;">Cuentas Baneadas Actualmente (<%= pagination.total.toLocaleString() %>)</h3>
                    </div>

                    <table>
                        <thead>
                            <tr>
                                <th>ID Baneo</th>
                                <th>Usuario / Game ID</th>
                                <th>Última IP</th>
                                <th>Motivo del Baneo</th>
                                <th>Duración / Expiración</th>
                                <th>GM Sancionador</th>
                                <th style="text-align: right;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (bans && bans.length > 0) { %>
                                <% bans.forEach(b => { %>
                                    <tr>
                                        <td>#<%= b.Id %></td>
                                        <td>
                                            <% if (b.game_user_id) { %>
                                                <a href="/players/<%= b.game_user_id %>" style="color: #60a5fa; font-weight: 700; text-decoration: none;">
                                                    <%= b.game_id %>
                                                </a>
                                                <span style="font-size: 11px; color: var(--text-dim); margin-left: 4px;">(<%= b.Username %>)</span>
                                            <% } else { %>
                                                <strong>ID Cuenta #<%= b.UserId %></strong>
                                            <% } %>
                                        </td>
                                        <td><code><%= b.last_ip || '—' %></code></td>
                                        <td><span style="color: #fca5a5;"><%= b.razon %></span></td>
                                        <td>
                                            <% if (b.date === 'Forever') { %>
                                                <span class="role-badge" style="background: #ef4444; color: #fff;">Permanente</span>
                                            <% } else { %>
                                                <span><%= new Date(parseInt(b.date)).toLocaleString('es-ES') %></span>
                                            <% } %>
                                        </td>
                                        <td><%= b.gm %> (ID: <%= b.gm_id %>)</td>
                                        <td style="text-align: right;">
                                            <form action="/moderation/unban" method="POST" style="margin: 0; display: inline;" onsubmit="return confirm('¿Desbanear esta cuenta?');">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="userId" value="<%= b.UserId %>">
                                                <button type="submit" class="btn btn-sm btn-success">
                                                    Desbanear
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="7" style="text-align: center; color: var(--text-dim); padding: 30px;">
                                        No se encontraron cuentas baneadas.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>

                    <% if (pagination.totalPages > 1) { %>
                        <div class="pagination-container">
                            <span>Mostrando <%= bans.length %> de <%= pagination.total %> baneos</span>
                            <div class="pagination-links">
                                <% for (let i = 1; i <= Math.min(pagination.totalPages, 10); i++) { %>
                                    <a href="/moderation?page=<%= i %><%= filters.search ? '&search=' + encodeURIComponent(filters.search) : '' %>" class="page-btn <%= pagination.page === i ? 'active' : '' %>">
                                        <%= i %>
                                    </a>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                </div>

                <!-- Muted Players Table -->
                <div class="card-table">
                    <div class="table-header">
                        <h3 style="font-size: 15px; font-weight: 700; color: #fff;">Jugadores Silenciados del Chat (<%= mutedPlayers.length %>)</h3>
                    </div>

                    <table>
                        <thead>
                            <tr>
                                <th>User ID</th>
                                <th>Game ID</th>
                                <th>Login</th>
                                <th>Estado de Conexión</th>
                                <th style="text-align: right;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (mutedPlayers && mutedPlayers.length > 0) { %>
                                <% mutedPlayers.forEach(m => { %>
                                    <tr>
                                        <td>#<%= m.Id %></td>
                                        <td><strong style="color: #60a5fa;"><%= m.game_id %></strong></td>
                                        <td><%= m.Username %></td>
                                        <td>
                                            <% if (m.IsOnline === 1) { %>
                                                <span class="status-pill online">Online</span>
                                            <% } else { %>
                                                <span class="status-pill offline">Offline</span>
                                            <% } %>
                                        </td>
                                        <td style="text-align: right;">
                                            <form action="/moderation/unmute" method="POST" style="margin: 0; display: inline;">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="userId" value="<%= m.Id %>">
                                                <button type="submit" class="btn btn-sm btn-secondary">
                                                    Desmutear Chat
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" style="text-align: center; color: var(--text-dim); padding: 20px;">
                                        No hay ningún jugador con silencio de chat activo.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Ban Modal Dialog -->
                <div id="ban-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); z-index: 1000; align-items: center; justify-content: center;">
                    <div style="background: #111827; border: 1px solid var(--border-color); border-radius: 12px; max-width: 480px; width: 90%; margin: 80px auto; padding: 28px;">
                        <h3 style="font-size: 18px; font-weight: 800; color: #f87171; margin-bottom: 16px;">
                            Aplicar Sanción / Ban
                        </h3>

                        <form action="/moderation/ban" method="POST">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                            <div class="form-group">
                                <label class="form-label">Jugador Objetivo (ID, Game ID o Username)</label>
                                <input type="text" name="userId" class="form-control" placeholder="Ej. Destroyer o 593" required>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Motivo del Baneo</label>
                                <input type="text" name="reason" class="form-control" placeholder="Ej. Uso de bots, bugs, insultos graves..." required>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Duración de la Sanción</label>
                                <select name="duration" class="form-control">
                                    <option value="1">1 Día</option>
                                    <option value="3">3 Días</option>
                                    <option value="7">7 Días</option>
                                    <option value="30">30 Días</option>
                                    <option value="90">90 Días</option>
                                    <option value="Forever" selected>Permanente (Forever)</option>
                                </select>
                            </div>

                            <div style="display: flex; gap: 10px; margin-top: 20px;">
                                <button type="submit" class="btn btn-danger" style="flex: 1;">Aplicar Baneo</button>
                                <button type="button" class="btn btn-secondary" onclick="document.getElementById('ban-modal').style.display='none'">Cancelar</button>
                            </div>
                        </form>
                    </div>
                </div>

            </main>

            <%- include('../layouts/footer') %>
        </div>
    </div>
</body>
</html>
