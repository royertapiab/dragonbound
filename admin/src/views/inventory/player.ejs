<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> — DragonBound Admin</title>
    <link rel="stylesheet" href="/static/css/admin.css">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚔️</text></svg>">
</head>
<body>
    <div class="app-container">
        <%- include('../layouts/sidebar') %>

        <div class="main-content">
            <%- include('../layouts/header') %>

            <main class="page-container">
                <%- include('../layouts/alerts') %>

                <!-- Player Header -->
                <div class="banner-info" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
                    <div>
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <a href="/players/<%= player.game_user_id %>" class="btn btn-sm btn-secondary" style="margin-right: 6px;">
                                &larr; Volver al Perfil
                            </a>
                            <h2 style="font-size: 18px; font-weight: 800; color: #fff;">
                                Inventario de <%= player.game_id %>
                            </h2>
                            <span class="role-badge MODERATOR">#<%= player.game_user_id %></span>
                        </div>
                        <div style="font-size: 13px; color: var(--text-dim); margin-top: 6px;">
                            Total: <strong><%= stats.total %></strong> avatares &bull; 
                            Activos: <strong style="color: var(--success);"><%= stats.active %></strong> &bull; 
                            En papelera: <strong style="color: var(--danger);"><%= stats.deleted %></strong>
                        </div>
                    </div>

                    <div>
                        <button type="button" class="btn btn-primary btn-sm" onclick="document.getElementById('grant-modal').style.display='block'">
                            + Añadir Avatar a este Jugador
                        </button>
                    </div>
                </div>

                <!-- Equipped Avatars Card -->
                <div class="card" style="margin-bottom: 24px;">
                    <h3 class="card-title">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                        Avatares Equipados Actualmente
                    </h3>

                    <div style="display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; text-align: center;">
                        <div style="background: #0d131f; padding: 12px; border-radius: 8px; border: 1px solid var(--border-color);">
                            <div style="font-size: 11px; color: var(--text-dim); margin-bottom: 4px;">CABEZA</div>
                            <div style="font-weight: 700; color: #60a5fa;"><%= equipped.head ? '#' + equipped.head : 'Ninguno' %></div>
                        </div>
                        <div style="background: #0d131f; padding: 12px; border-radius: 8px; border: 1px solid var(--border-color);">
                            <div style="font-size: 11px; color: var(--text-dim); margin-bottom: 4px;">CUERPO</div>
                            <div style="font-weight: 700; color: #60a5fa;"><%= equipped.body ? '#' + equipped.body : 'Ninguno' %></div>
                        </div>
                        <div style="background: #0d131f; padding: 12px; border-radius: 8px; border: 1px solid var(--border-color);">
                            <div style="font-size: 11px; color: var(--text-dim); margin-bottom: 4px;">LENTES</div>
                            <div style="font-weight: 700; color: #60a5fa;"><%= equipped.eyes ? '#' + equipped.eyes : 'Ninguno' %></div>
                        </div>
                        <div style="background: #0d131f; padding: 12px; border-radius: 8px; border: 1px solid var(--border-color);">
                            <div style="font-size: 11px; color: var(--text-dim); margin-bottom: 4px;">BANDERA</div>
                            <div style="font-weight: 700; color: #60a5fa;"><%= equipped.flag ? '#' + equipped.flag : 'Ninguno' %></div>
                        </div>
                        <div style="background: #0d131f; padding: 12px; border-radius: 8px; border: 1px solid var(--border-color);">
                            <div style="font-size: 11px; color: var(--text-dim); margin-bottom: 4px;">FONDO</div>
                            <div style="font-weight: 700; color: #60a5fa;"><%= equipped.background ? '#' + equipped.background : 'Ninguno' %></div>
                        </div>
                        <div style="background: #0d131f; padding: 12px; border-radius: 8px; border: 1px solid var(--border-color);">
                            <div style="font-size: 11px; color: var(--text-dim); margin-bottom: 4px;">FRENTE</div>
                            <div style="font-weight: 700; color: #60a5fa;"><%= equipped.foreground ? '#' + equipped.foreground : 'Ninguno' %></div>
                        </div>
                    </div>
                </div>

                <!-- Inventory Items Table -->
                <div class="card-table">
                    <div class="table-header">
                        <h3 style="font-size: 15px; font-weight: 700; color: #fff;">Lista de Avatares en Posesión</h3>
                    </div>

                    <table>
                        <thead>
                            <tr>
                                <th>Item ID</th>
                                <th>Nombre</th>
                                <th>Categoría</th>
                                <th>Equipado</th>
                                <th>Tipo</th>
                                <th>Vencimiento</th>
                                <th>Estado</th>
                                <th style="text-align: right;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (items && items.length > 0) { %>
                                <% items.forEach(item => { %>
                                    <tr style="<%= item.remove_ava === 1 ? 'opacity: 0.6;' : '' %>">
                                        <td><strong>#<%= item.aId %></strong></td>
                                        <td>
                                            <span style="font-weight: 600; color: #fff;"><%= item.name %></span>
                                            <% if (item.filename) { %>
                                                <span style="font-size: 11px; color: var(--text-dim); margin-left: 4px;">(<%= item.filename %>)</span>
                                            <% } %>
                                        </td>
                                        <td><%= getAvatarTypeName(item.itemType) %></td>
                                        <td>
                                            <% if (item.isEquipped) { %>
                                                <span class="role-badge GM" style="font-size: 10px;">EQUIPADO</span>
                                            <% } else { %>
                                                <span style="color: var(--text-dim); font-size: 12px;">No</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (item.is_cash === 1) { %>
                                                <span style="color: #34d399; font-weight: 600;">Cash</span>
                                            <% } else { %>
                                                <span style="color: var(--gold); font-weight: 600;">Gold</span>
                                            <% } %>
                                            <% if (item.is_gift === 1) { %>
                                                <span style="font-size: 11px; color: var(--text-dim);"> (Regalo)</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (!item.expire_time || item.expire_time === '0' || item.expire_time == 0) { %>
                                                <span style="color: #60a5fa; font-weight: 600;">Permanente</span>
                                            <% } else if (item.isExpired) { %>
                                                <span style="color: #f87171;">Expirado</span>
                                            <% } else { %>
                                                <span style="color: var(--warning);"><%= item.daysLeft %> días restantes</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (item.remove_ava === 1) { %>
                                                <span class="status-pill offline" style="color: #f87171;">En Papelera</span>
                                            <% } else { %>
                                                <span class="status-pill online">Activo</span>
                                            <% } %>
                                        </td>
                                        <td style="text-align: right;">
                                            <div style="display: inline-flex; gap: 6px;">
                                                <% if (item.remove_ava === 0) { %>
                                                    <form action="/inventory/<%= item.Id %>/remove" method="POST" style="margin: 0;">
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                        <button type="submit" class="btn btn-sm btn-secondary" title="Mover a papelera">
                                                            Papelera
                                                        </button>
                                                    </form>
                                                <% } else { %>
                                                    <form action="/inventory/<%= item.Id %>/restore" method="POST" style="margin: 0;">
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                        <button type="submit" class="btn btn-sm btn-success" title="Restaurar a activo">
                                                            Restaurar
                                                        </button>
                                                    </form>
                                                <% } %>

                                                <form action="/inventory/<%= item.Id %>/delete" method="POST" style="margin: 0;" onsubmit="return confirm('¿Eliminar permanentemente este avatar? Esta acción no se puede deshacer.');">
                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                    <button type="submit" class="btn btn-sm btn-danger" title="Eliminar definitivamente">
                                                        &times;
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="8" style="text-align: center; color: var(--text-dim); padding: 30px;">
                                        El inventario de este jugador está completamente vacío.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Grant Modal Dialog -->
                <div id="grant-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); z-index: 1000; align-items: center; justify-content: center;">
                    <div style="background: #111827; border: 1px solid var(--border-color); border-radius: 12px; max-width: 480px; width: 90%; margin: 80px auto; padding: 28px;">
                        <h3 style="font-size: 18px; font-weight: 800; color: #60a5fa; margin-bottom: 16px;">
                            Otorgar Avatar a <%= player.game_id %>
                        </h3>

                        <form action="/inventory/grant" method="POST">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="userId" value="<%= player.game_user_id %>">

                            <div class="form-group">
                                <label class="form-label">Avatar ID (del Catálogo Maestro)</label>
                                <input type="number" name="aId" class="form-control" placeholder="Ej. 3691" required>
                                <span style="font-size: 12px; color: var(--text-dim); margin-top: 4px; display: block;">
                                    Puedes consultar IDs en la sección <a href="/inventory" target="_blank" style="color: #60a5fa;">Catálogo de Avatares</a>.
                                </span>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Duración / Vencimiento</label>
                                <select name="expireDays" class="form-control">
                                    <option value="0" selected>Permanente (Sin límite)</option>
                                    <option value="7">7 Días</option>
                                    <option value="30">30 Días</option>
                                    <option value="90">90 Días</option>
                                </select>
                            </div>

                            <div class="form-grid-2">
                                <div class="form-group">
                                    <label class="form-label">Flag de Cash</label>
                                    <select name="isCash" class="form-control">
                                        <option value="1" selected>Sí (Item Cash)</option>
                                        <option value="0">No (Item Gold)</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Flag de Regalo</label>
                                    <select name="isGift" class="form-control">
                                        <option value="1" selected>Sí (Es Regalo)</option>
                                        <option value="0">No (Comprado)</option>
                                    </select>
                                </div>
                            </div>

                            <div style="display: flex; gap: 10px; margin-top: 20px;">
                                <button type="submit" class="btn btn-primary" style="flex: 1;">Entregar al Jugador</button>
                                <button type="button" class="btn btn-secondary" onclick="document.getElementById('grant-modal').style.display='none'">Cancelar</button>
                            </div>
                        </form>
                    </div>
                </div>

            </main>

            <%- include('../layouts/footer') %>
        </div>
    </div>
</body>
</html>
