<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DragonBound — Panel Administrativo</title>
    <link rel="stylesheet" href="/static/css/admin.css">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚔️</text></svg>">
</head>
<body class="login-body">
    <div class="login-card">
        <div class="login-brand">
            <div class="login-logo">DB</div>
            <h1>DragonBound</h1>
            <p>Panel de Administración Oficial</p>
        </div>

        <% if (error) { %>
            <div class="alert-danger">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span><%= error %></span>
            </div>
        <% } %>

        <form action="/login" method="POST" autocomplete="off">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="form-group">
                <label class="form-label" for="username">Usuario del Juego</label>
                <input 
                    type="text" 
                    id="username" 
                    name="username" 
                    class="form-control" 
                    placeholder="Ej. Destroyer" 
                    value="<%= username || '' %>"
                    required 
                    autofocus
                >
            </div>

            <div class="form-group">
                <label class="form-label" for="password">Contraseña</label>
                <input 
                    type="password" 
                    id="password" 
                    name="password" 
                    class="form-control" 
                    placeholder="••••••••••••" 
                    required
                >
            </div>

            <button type="submit" class="btn-primary">
                Iniciar Sesión Administrativa
            </button>
        </form>

        <div class="login-footer-hint">
            <p><strong>Autenticación Unificada:</strong> Ingresa utilizando las mismas credenciales de tu cuenta del juego.</p>
            <p style="margin-top: 6px;">El acceso está restringido exclusivamente a cuentas registradas en <code>admin_users</code> con rol asignado.</p>
        </div>
    </div>
</body>
</html>
